{
  "name": "nextlock",
  "version": "1.2.0",
  "description": "NeXtLock - Premium Password Manager Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "password-manager",
    "security",
    "electron",
    "desktop-app"
  ],
  "author": "Nimesh Alwis",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nextlock.app",
    "productName": "NeXtLock",
    "icon": "Nextlock2.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "index.html",
      "Nextlock2.ico",
      "Nextlock2.png",
      "icon.png",
      "offcial icon logo.png"
    ],
    "win": {
      "icon": "Nextlock2.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeXtLock"
    }
  }
}